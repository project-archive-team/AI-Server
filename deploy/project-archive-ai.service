[Unit]
Description=Project Archive AI Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/ai-server/current
EnvironmentFile=/home/ec2-user/ai-server/.env
ExecStart=/home/ec2-user/ai-server/current/.venv/bin/uvicorn ai_app:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
